PORT=3001
FRAUDSHIELD_BIND_HOST=127.0.0.1
FRAUDSHIELD_MODEL_DISABLED=0
# Development binds only to 127.0.0.1. Production requires all settings below.
NODE_ENV=development
FRAUDSHIELD_TLS_TERMINATED=0
FRAUDSHIELD_ADMIN_TOKEN=
FRAUDSHIELD_INVESTIGATOR_TOKEN=
FRAUDSHIELD_ALLOWED_ORIGINS=
FRAUDSHIELD_DATA_DIR=./data
# Optional overrides: FRAUDSHIELD_MODEL_PATH and FRAUDSHIELD_AUDIT_PATH
